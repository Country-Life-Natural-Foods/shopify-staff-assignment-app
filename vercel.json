{
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/simple.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/metrics/cron-backfill",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
