# Shopify Staff Assignment App Configuration

# Your app's API key and secret from Partner Dashboard
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Your app's URL (use ngrok for local development)
SHOPIFY_APP_URL=https://your-app-url.ngrok.io

# Database configuration
DATABASE_URL=./database.sqlite

# Session secret (generate a random string)
SESSION_SECRET=your_session_secret_here

# B2B Map Sync - use EITHER (A) or (B)
# Scopes: read_companies, read_metaobjects, write_metaobjects
SHOPIFY_SHOP_DOMAIN=clnf.myshopify.com
MAPBOX_ACCESS_TOKEN=pk.xxxx

# (A) Dev Dashboard app (client credentials - recommended for new apps)
# Get from: dev.shopify.com → Your app → Settings
SHOPIFY_CLIENT_ID=6f3d469d72ff9f200fdefa5c8cd5d77f
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# (B) Legacy custom app (static token from Shopify Admin)
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxx

# Optional: secret for cron/webhook calls to /api/sync-b2b-map
CRON_SECRET=your_random_secret

# Optional: cron schedule (default: 0 0 * * * = midnight UTC)
# For midnight Eastern: 0 5 * * * (winter) or 0 4 * * * (summer)
CRON_SCHEDULE=0 0 * * *

# Environment
NODE_ENV=development

# Optional: Enable debug logging
DEBUG=false
